# mesh-daemon image: the MossyMesh offline routing node
# (mesh-transport crate, `mesh-daemon` binary).
#
# The daemon serves the interop HTTP API on MESH_GATEWAY_BIND
# (default 127.0.0.1:8080; this image binds 0.0.0.0:8080 so the published
# port is reachable) and loads the engine WASM from
# sandbox/assets/engine.wasm at runtime when built without the
# `bundled-engine` feature.
#
# Build from the repo root. engine.wasm is gitignored, so stage it first
# (CI stages the engine-wasm artifact automatically):
#   ./devops/build-engine-wasm.sh
#   docker build -f devops/Dockerfile.daemon -t mossymesh/daemon:local .
# Run:
#   docker run -p 8080:8080 mossymesh/daemon:local

# ---------- builder ----------
FROM rust:1-bookworm AS builder
WORKDIR /app
COPY . .
RUN cargo build --release --locked -p mesh-transport --bin mesh-daemon

# ---------- runtime ----------
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/target/release/mesh-daemon /usr/local/bin/mesh-daemon
# Runtime engine.wasm for the sandbox loader (staged by CI from the
# engine-wasm artifact; build locally with ./devops/build-engine-wasm.sh).
COPY sandbox/assets/engine.wasm /app/sandbox/assets/engine.wasm
WORKDIR /app
ENV MESH_GATEWAY_BIND=0.0.0.0:8080
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/api/v1/health | grep -q "Mesh Island Active" || exit 1
CMD ["mesh-daemon"]
